{
  "name": "gachakit",
  "version": "0.1.0",
  "private": true,
  "description": "A modular static site generator that dispenses UI Capsules.",
  "keywords": [
    "static-site-generator",
    "capsules",
    "vanilla-js",
    "template"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnalogCyan/GachaKit.git"
  },
  "homepage": "https://github.com/AnalogCyan/GachaKit#readme",
  "bugs": {
    "url": "https://github.com/AnalogCyan/GachaKit/issues"
  },
  "type": "module",
  "main": "lib/engine.js",
  "exports": {
    ".": "./lib/engine.js",
    "./engine": "./lib/engine.js"
  },
  "files": [
    "lib/",
    "build.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "LICENSE-CONTENT"
  ],
  "scripts": {
    "build": "node build.js",
    "dev": "npm run build && npx serve public",
    "lab": "node tools/capsule-lab.js && npx serve .capsule-lab/public -l 4700",
    "test": "node --test \"test/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=24"
  },
  "author": {
    "name": "AnalogCyan",
    "url": "https://github.com/AnalogCyan"
  },
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "serve": "14.2.6"
  }
}
